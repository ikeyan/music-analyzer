DATABASE_URL="file:./dev.db"

# Blob storage (S3 or S3-compatible server such as MinIO/LocalStack).
# Leave S3_ENDPOINT unset when using AWS S3.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="music-analyzer"

# Shared secret between the upstream auth proxy (Caddy + Authentik forward_auth)
# and the app. The proxy must send it as `x-auth-proxy-secret`; requests without
# a matching value get 401. Required in production / staging — when unset and
# NODE_ENV!=development the app fails closed with 503.
# Generate with: openssl rand -hex 32
AUTH_PROXY_SECRET=""

# Secrets (S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, AUTH_PROXY_SECRET) can be
# supplied via a file by setting `<NAME>_FILE=/path/to/file` instead of `<NAME>`
# directly. Useful for Docker secrets or k8s mounted secrets. A single trailing
# newline in the file is stripped. Setting both `<NAME>` and `<NAME>_FILE` is an
# error.
# Example:
#   S3_ACCESS_KEY_ID_FILE=/run/secrets/s3_access_key_id
#   S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_access_key
#   AUTH_PROXY_SECRET_FILE=/run/secrets/auth_proxy_secret
