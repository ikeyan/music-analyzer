{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/session-start.ts"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ikeyan": {
      "source": {
        "source": "github",
        "repo": "ikeyan/agent-files"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ikeyan-skills@ikeyan": true
  }
}
