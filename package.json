{
  "name": "music-analyzer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "bun run build && bun run ./dist/index.js",
    "test": "bun test --path-ignore-patterns='**/*.frontend.test.ts' app/",
    "test:coverage": "bun test --coverage --path-ignore-patterns='**/*.frontend.test.ts' app/",
    "test:frontend": "bun test app/islands/*.frontend.test.ts",
    "e2e:authentik": "RUN_AUTHENTIK_E2E=1 bun test e2e/authentik/flow.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run test:frontend",
    "db:generate": "DATABASE_URL=file:/dev/null prisma generate",
    "db:push": "prisma db push",
    "db:seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@hono/react-renderer": "^1.0.1",
    "@hono/valibot-validator": "^0.6.1",
    "@prisma/client": "^7",
    "effect": "^3.22.0",
    "hono": "^4.12.31",
    "honox": "^0.1.59",
    "prisma-adapter-bun-sqlite": "^0.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fast-check": "^4.9.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "p-map": "^7.0.5",
    "prisma": "^7",
    "testcontainers": "^11.14.0",
    "type-fest": "^5.8.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "honox@0.1.55": "patches/honox@0.1.55.patch"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "better-sqlite3",
    "cpu-features",
    "esbuild",
    "prisma",
    "protobufjs",
    "ssh2"
  ]
}
