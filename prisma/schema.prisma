generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  authentikSub String    @unique
  username     String?
  email        String?
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  videos    Video[]
  audios    Audio[]
  uploads   Upload[]
  tasks     Task[]

  @@index([userId])
}

model Video {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  order     Int
  name      String

  videoKey String
  audioKey String?

  durationSec  Float
  width        Int
  height       Int
  fps          Float
  videoBitrate Int?
  audioBitrate Int?
  sizeBytes    BigInt

  srcStartSec  Float @default(0)
  srcEndSec    Float
  projStartSec Float
  projEndSec   Float

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  thumbnails Thumbnail[]

  @@unique([projectId, order])
  @@index([projectId])
}

model Audio {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  order     Int
  name      String

  audioKey       String // 標準化AAC m4a (常に存在、ブラウザ再生可)
  rawKey         String? // browser再生可能と判断した入力のみ raw を保存
  rawContentType String?

  durationSec Float
  sampleRate  Int?
  channels    Int?
  bitrate     Int?
  sizeBytes   BigInt

  srcStartSec  Float @default(0)
  srcEndSec    Float
  projStartSec Float
  projEndSec   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, order])
  @@index([projectId])
}

model Thumbnail {
  id      String @id @default(cuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id])
  atSec   Float
  key     String
  width   Int
  height  Int

  @@unique([videoId, atSec])
  @@index([videoId])
}

// 分割アップロードのセッション。expiresAt (createdAt + 1h) を過ぎても
// completed にならなければ DeletionMark の grace でチャンクごと回収される
model Upload {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id])
  kind          String // "video" | "audio"
  fileName      String
  contentType   String?
  totalBytes    BigInt
  chunkSize     Int
  totalChunks   Int
  receivedBytes BigInt        @default(0)
  status        String        @default("pending") // "pending" | "completed" | "aborted"
  expiresAt     DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  chunks        UploadChunk[]
  tasks         Task[]

  @@index([projectId])
  @@index([expiresAt])
}

// 受け取った各チャンクの存在を記録する。complete 時に 0..totalChunks-1 が
// 揃っているかをこの行集合で検証する
model UploadChunk {
  id        String   @id @default(cuid())
  uploadId  String
  upload    Upload   @relation(fields: [uploadId], references: [id])
  index     Int
  sizeBytes BigInt
  createdAt DateTime @default(now())

  @@unique([uploadId, index])
  @@index([uploadId])
}

// プロジェクトに属する非同期タスクの汎用エンティティ。
// 現状は media validation (ffmpeg probe + transcode) でのみ使う
model Task {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id])
  type       String // "video_validation" | "audio_validation"
  status     String    @default("pending") // "pending" | "running" | "succeeded" | "failed"
  error      String?
  uploadId   String?
  upload     Upload?   @relation(fields: [uploadId], references: [id])
  videoId    String?
  audioId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([projectId])
  @@index([status])
}

// DBのrow deleteと同じトランザクションで挿入する S3 prefix の墓標。
// 同期best-effort cleanupが失敗してもsweeperが拾うので
// (DB, S3) は eventually consistent になる
model DeletionMark {
  id          String   @id @default(cuid())
  prefix      String
  attempts    Int      @default(0)
  lastError   String?
  // 次に sweeper が拾える時刻。挿入時は upload grace 分先 (orphan 防止用墓標を
  // upload 完了より前に置くため、sweeper が in-progress な S3 を消さないよう grace を取る)
  nextRetryAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([nextRetryAt])
}
